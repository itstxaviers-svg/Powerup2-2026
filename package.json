{
  "name": "power-up-2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "dev:student": "vite --host 127.0.0.1 --port 4173",
    "dev:teacher": "vite --host 127.0.0.1 --port 4174",
    "assets:web": "node scripts/build-web-assets.mjs",
    "build": "tsc -b && vite build",
    "build:student": "tsc -b && VITE_APP_ROLE=student VITE_REQUIRE_LOGIN=true vite build",
    "build:teacher": "tsc -b && VITE_REQUIRE_LOGIN=true vite build --config vite.teacher.config.ts",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "idb": "^8.0.3",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "sharp": "^0.34.5",
    "vitest": "^4.1.11"
  }
}
